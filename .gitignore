###############################################################################
# UNITY PROJECT – SAFE TEAM SETUP
# Works for Unity 2021 LTS / 2022 LTS / 2023 LTS
###############################################################################

# ---------------------------------------------------------------------------
# Unity generated folders (NEVER commit)
# ---------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Mm]emoryCaptures/
[Bb]uild/
[Bb]uilds/
UserSettings/

# Shader & Addressables caches
Library/ShaderCache/
Library/ScriptAssemblies/
Library/com.unity.addressables/

# ---------------------------------------------------------------------------
# Visual Studio / Rider / VSCode
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
.vsconfig

# Solution & project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# OS / Editor junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
sysinfo.txt

# ---------------------------------------------------------------------------
# Unity crash & build outputs
# ---------------------------------------------------------------------------
crashlytics-build.properties
*.apk
*.aab
*.unitypackage

# ---------------------------------------------------------------------------
# Git merge leftovers
# ---------------------------------------------------------------------------
*.orig
*.orig.meta

# ---------------------------------------------------------------------------
# Unity Package Manager
# ---------------------------------------------------------------------------
# KEEP THESE (do NOT ignore):
#   Packages/manifest.json
#   Packages/packages-lock.json
#   ProjectSettings/

# Ignore only CI / cache artifacts
upm-ci~/
upm-ci.log

# ---------------------------------------------------------------------------
# Unity Samples (IMPORTANT: do NOT version these)
# ---------------------------------------------------------------------------
Assets/Samples/

# ---------------------------------------------------------------------------
# Asset Store tools (optional)
# ---------------------------------------------------------------------------
Assets/AssetStoreTools*

# ---------------------------------------------------------------------------
# JetBrains Rider plugin (auto-generated)
# ---------------------------------------------------------------------------
Assets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------------------
# Build reports
# ---------------------------------------------------------------------------
Assets/BuildReports*

# ---------------------------------------------------------------------------
# Meta files MUST be tracked
# ---------------------------------------------------------------------------
!Assets/**/*.meta

# Never ignore DLLs in the FMOD subfolder.
!/[Aa]ssets/Plugins/FMOD/**/lib/*

# Don't ignore images and gizmos used by FMOD in the Unity Editor.
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# If the source bank files are kept outside of the StreamingAssets folder then these can be ignored.
# Log files can be ignored.
fmod_editor.log
